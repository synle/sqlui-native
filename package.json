{
  "name": "sqlui-native",
  "version": "6.2.1",
  "private": true,
  "description": "A minimal native desktop client for most databases supporting MySQL, MariaDB, MS SQL Server, PostgreSQL, SQLite, Cassandra, MongoDB and Redis.",
  "keywords": [
    "Cassandra",
    "MariaDB",
    "Microsoft",
    "MySQL",
    "Native Desktop Application",
    "PostgreSQL",
    "SQL",
    "SQLite",
    "Tauri"
  ],
  "homepage": "./",
  "license": "MIT",
  "author": {
    "name": "Sy Le",
    "email": "le.nguyen.sy@gmail.com"
  },
  "repository": "https://github.com/synle/sqlui-native",
  "scripts": {
    "### Cleanup & Maintenance ###": "##################################################################################",
    "clean": "rm -rf build src/package.json ./dist/*",
    "cleanSnapshot": "rm -rf src/common/adapters/__snapshots__/ src/common/adapters/BaseDataAdapter/__snapshots__/ && npm run test-ci -- --update",
    "format": "oxfmt --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:ci": "oxfmt --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "oxfmt --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint": "oxlint --fix src",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "### Build Lifecycle ###": "##################################################################################",
    "prebuild": "node scripts/prebuild.js",
    "build": "vite build --config vite.frontend.config.ts",
    "postbuild": "npm run build-server",
    "build-server": "vite build --config vite.sqlui-server.config.ts",
    "build-server-sidecar": "vite build --config vite.sqlui-server.sidecar.config.ts",
    "build:tauri": "cross-env-shell NODE_OPTIONS=--max-old-space-size=8192 \"npm run prebuild && npm run build && npm run build-server-sidecar && node scripts/download-node.js && node scripts/prepare-sidecar.js\"",
    "build:portal": "cross-env-shell NODE_OPTIONS=--max-old-space-size=8192 \"npm run prebuild && node scripts/build-portal.js\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "### Development & Execution ###": "##################################################################################",
    "predev": "node scripts/prebuild.js",
    "dev": "concurrently \"npm run dev-server\" \"npm run start-webapp\"",
    "start": "npm run tauri:dev",
    "start-webapp": "cross-env ENV_TYPE='browser' vite --config vite.frontend.config.ts --strictPort",
    "prestart-server": "npm run build-server",
    "start-server": "node build/sqlui-server.js",
    "dev-server": "concurrently \"vite build --config vite.sqlui-server.config.ts --watch\" \"nodemon --watch build/sqlui-server.js --delay 1 -- build/sqlui-server.js\"",
    "### Validation ###": "##################################################################################",
    "validate": "npm run lint && npm run typecheck && npm run test-ci && npm run format && npm run test-e2e && npm run test-smoke && npm run test-integration",
    "### Testing ###": "##################################################################################",
    "pretest": "npm run build",
    "test": "vitest --watch",
    "pretest-ci": "npm run pretest",
    "test-ci": "vitest run",
    "test-integration": "vitest run --config vitest.integration.config.ts",
    "start-e2e": "concurrently \"node build/sqlui-server.js\" \"vite preview --config vite.frontend.config.ts --strictPort\"",
    "test-e2e": "npx playwright test",
    "test-smoke": "npx playwright test --config playwright.smoke.config.ts",
    "### Distribution & Packaging ###": "##################################################################################",
    "dist": "npm run tauri:build"
  },
  "dependencies": {
    "@azure/cosmos": "^3.17.1",
    "@azure/data-tables": "^13.1.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hono/node-server": "2.1.5",
    "@iarna/toml": "2.2.5",
    "@mui/icons-material": "9.5.0",
    "@mui/lab": "9.0.0-beta.10",
    "@mui/material": "9.5.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-devtools": "5.105.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "3.14.23",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-shell": "2.5.0",
    "@testing-library/dom": "10.4.2",
    "@xyflow/react": "12.12.0",
    "cassandra-driver": "^3.6.0",
    "connection-string-parser": "^1.0.4",
    "dompurify": "3.4.17",
    "fast-xml-parser": "5.11.2",
    "fuzzysort": "4.0.2",
    "hono": "4.13.14",
    "html-to-image": "^1.11.13",
    "js-beautify": "2.0.3",
    "jsforce": "3.12.0",
    "json-2-csv": "5.6.0",
    "jsonc-parser": "3.3.1",
    "monaco-editor": "0.57.0",
    "mongodb": "^4.10.0",
    "mustache": "^4.2.0",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "qs": "6.16.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "^7.18.4",
    "redis": "^4.3.1",
    "sql-formatter": "15.9.0",
    "tedious": "^19.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "16.3.3",
    "@types/cassandra-driver": "^3.6.0",
    "@types/js-beautify": "^1.13.3",
    "@types/mustache": "^4.2.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/redis": "^4.0.11",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "concurrently": "10.0.6",
    "cross-env": "^10.1.0",
    "jsdom": "^24.1.3",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.14",
    "oxfmt": "0.74.0",
    "oxlint": "^1.89.0",
    "sass": "^1.106.1",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "dompurify": "$dompurify"
  },
  "engine": "Tauri + Node Sidecar"
}
